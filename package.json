{
  "name": "sgt",
  "version": "0.1.0",
  "private": true,
  "description": "SGT - Sistema de Gestión de Turnos de Enfermería (TurnoCare)",
  "author": "Santiago Caicedo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "iniciar": "node scripts/iniciar.mjs",
    "instalador": "npm run empaquetar -w @sgt/desktop",
    "guia:pdf": "npm run build && node apps/desktop/scripts/empaquetar-api.mjs && electron scripts/guia/generar.cjs",
    "docs": "doxygen Doxyfile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:desktop": "npm run dev -w @sgt/desktop",
    "dev:api": "npm run dev -w @sgt/api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
