{
  "name": "@sgt/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de aplicación del SGT (NestJS). Persistencia en archivos JSON, sin base de datos",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --enable-source-maps --test \"dist-test/**/*.test.js\"",
    "semilla:demo": "node --env-file-if-exists=.env dist/semilla-demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "socket.io-client": "^4.8.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "@node-rs/argon2": "^2.2.1",
    "@sgt/rules-engine": "*",
    "@sgt/shared-types": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  }
}
